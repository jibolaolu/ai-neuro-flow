# Neuro Flow — canonical local host ports (single source of truth)
# Sourced by run_local.sh, run-local.sh, and Documents/localproxy/setup_local_https_proxy.sh
# nginx HTTPS: https://neuroflow.localtest.me:8443 → NEUROFLOW_WEB_PORT (3004)
#              https://neuroflow-api.localtest.me:8443 → NEUROFLOW_API_PORT (8004)

NEUROFLOW_WEB_PORT=3004
NEUROFLOW_API_PORT=8004

# Optional: other local apps on the same machine (must not equal Neuro Flow ports)
NESTIQ_WEB_PORT=3000
NESTIQ_API_PORT=8000

# Docker dev compose maps host → container (see docker-compose.yml)
# Postgres in docker-compose.prod.yml is internal-only (no host port)
