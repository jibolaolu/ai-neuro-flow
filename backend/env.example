# Neuro Flow backend — copy to .env

DATABASE_URL=sqlite:///./neuro_flow.db
ENVIRONMENT=development
LOG_LEVEL=INFO

# Branding
PLATFORM_DISPLAY_NAME=Neuro Flow
PLATFORM_TAGLINE=NICE-aligned neurodevelopmental assessment for clinics
SUPPORT_EMAIL=support@neuroflow.app
# Direct localhost (no nginx):
PLATFORM_BASE_URL=http://localhost:3004
FRONTEND_URL=http://localhost:3004
EXTRA_CORS_ORIGINS=

# With nginx localproxy (setup_local_https_proxy.sh, HTTPS on :8443):
# PLATFORM_BASE_URL=https://neuroflow.localtest.me:8443
# FRONTEND_URL=https://neuroflow.localtest.me:8443
# EXTRA_CORS_ORIGINS=https://neuroflow.localtest.me:8443,https://neuroflow-api.localtest.me:8443

# Auth — production uses Auth0 (RS256 access tokens). Local JWT is dev-only.
JWT_SECRET=neuroflow-dev-secret-change-in-production
AUTH_COOKIE_NAME=neuroflow_token

# Signup / trials
SIGNUP_TRIAL_DAYS=14
# Set false in production to require invite-only onboarding
ALLOW_PUBLIC_SIGNUP=true

# Legacy WooCommerce patient intake (off for standalone Neuro Flow)
ENABLE_LEGACY_WOOCOMMERCE_WEBHOOK=false
WEBHOOK_SECRET=

# Stripe — clinic subscriptions (not patient checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=

# Email (optional in dev — logs to console if empty)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@neuroflow.app
ADMIN_NOTIFICATION_EMAIL=admin@neuroflow.app

# AI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Auth0 (required in production) ──────────────────────────────────────────
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://neuroflow-api
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Management API (Machine-to-Machine) — for: node scripts/setup-auth0.js
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
AUTH0_CONNECTION=Username-Password-Authentication

# Production
# ENVIRONMENT=production
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/neuroflow
# JWT_SECRET=<openssl rand -hex 32>
# FRONTEND_URL=https://app.yourdomain.com
# PLATFORM_BASE_URL=https://app.yourdomain.com
# ALLOW_PUBLIC_SIGNUP=false
# See docs/PRODUCTION.md
