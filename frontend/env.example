# Neuro Flow frontend — copy to .env.local

# Leave empty for same-origin /api/v1 proxy via Next.js
NEXT_PUBLIC_API_URL=
BACKEND_URL=http://127.0.0.1:8004

# ── Auth0 (Next.js SDK — required in production) ─────────────────────────────
# Generate AUTH0_SECRET: openssl rand -hex 32
AUTH0_SECRET=
# localhost, or nginx: https://neuroflow.localtest.me:8443
AUTH0_BASE_URL=http://localhost:3004
AUTH0_ISSUER_BASE_URL=https://YOUR_TENANT.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://neuroflow-api
# Must match backend AUTH0_AUDIENCE

# nginx HTTPS API (optional — browser calls API directly):
# NEXT_PUBLIC_API_URL=https://neuroflow-api.localtest.me:8443

# Production (NODE_ENV=production):
# BACKEND_URL=http://api:8000  (internal Docker hostname)
# AUTH0_BASE_URL=https://app.yourdomain.com
# Cookies are set with Secure when NODE_ENV=production or X-Forwarded-Proto=https
