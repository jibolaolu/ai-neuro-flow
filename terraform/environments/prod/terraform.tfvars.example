# Copy to terraform.tfvars (never commit secrets).
# All TF_VAR_* values are injected by GitHub Actions from repository secrets.

aws_region   = "eu-west-2"
environment  = "prod"
project_name = "neuroflow"

# DNS
frontend_domain = "neuroflow.eaglessolutions.co.uk"
api_domain      = "neuroflow-api.eaglessolutions.co.uk"
route53_zone_id = "Z02866112UE0M0NEAFMZO"

# ECS sizing (prod — 2 replicas for HA)
frontend_desired_count = 2
backend_desired_count  = 2
workers_desired_count  = 1
frontend_task_cpu      = 512
frontend_task_memory   = 1024
backend_task_cpu       = 1024
backend_task_memory    = 2048

# RDS
db_name            = "neuroflow"
db_username        = "neuroflow_admin"
db_instance_class  = "db.t4g.small"
db_allocated_storage = 20

# Image tags — set by CI to the git SHA
frontend_image_tag   = "latest"
backend_image_tag    = "latest"
ai_workers_image_tag = "latest"

# Platform branding
platform_display_name = "NeuroFlow"
platform_tagline      = "NICE-aligned neurodevelopmental assessment for clinics"
support_email         = "support@neuroflow.eaglessolutions.co.uk"
admin_notification_email = "admin@neuroflow.eaglessolutions.co.uk"

# Secrets — injected via TF_VAR_* in CI (never store here)
# db_password                = ""
# jwt_secret                 = ""   # openssl rand -hex 32
# anthropic_api_key          = ""
# sendgrid_api_key           = ""
# stripe_secret_key          = ""
# stripe_webhook_secret      = ""
# stripe_price_starter       = ""
# stripe_price_professional  = ""
# stripe_price_enterprise    = ""
