aws_region   = "eu-west-2"
environment  = "dev"
project_name = "neuroflow"

frontend_domain = "neuroflow.development.eaglessolutions.co.uk"
api_domain      = "neuroflow-api.development.eaglessolutions.co.uk"
route53_zone_id = "Z02866112UE0M0NEAFMZO"

frontend_desired_count = 1
backend_desired_count  = 1
workers_desired_count  = 1

db_name           = "neuroflow"
db_username       = "neuroflow_admin"
db_instance_class = "db.t4g.micro"

platform_display_name    = "NeuroFlow Dev"
support_email            = "support@neuroflow.eaglessolutions.co.uk"
admin_notification_email = "admin@neuroflow.eaglessolutions.co.uk"

